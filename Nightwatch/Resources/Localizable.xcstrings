      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never seen the aurora at all"
          }
        }
      }
    },
    "onboarding.quiz.wound.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you ever missed one?"
          }
        }
      }
    },
    "onboarding.reflection.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
