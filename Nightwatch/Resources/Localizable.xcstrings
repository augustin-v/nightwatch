    "onboarding.hook.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody told you it would be."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fortalte deg at det ville skje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sa till dig att det skulle bli så."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei kertonut sinulle etukäteen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fortalte dig, at det ville ske."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat dir keiner gesagt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand had je gewaarschuwd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne vous avait prévenu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt Cię nie ostrzegł."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ti aveva avvisato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie te avisó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo vás nevaroval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰も教えてくれませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무도 알려주지 않았죠."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人告訴你會這樣。"
          }
        }
      }
    },
    "onboarding.hook.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You drove out. It was cloudy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kjørte ut. Det var overskyet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du körde ut. Det var mulet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoit sinne. Taivas oli pilvessä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kørte ud. Det var overskyet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist rausgefahren. Es war bewölkt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reed erheen. Het was bewolkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sorti. Le ciel était couvert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojechałeś(-aś). Było pochmurno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei uscito. Era nuvoloso."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saliste a buscarla. Estaba nublado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyjeli jste ven. Bylo zataženo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見に出かけた。でも曇っていた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보러 나갔지만, 구름뿐이었어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你開車出門，結果滿天都是雲。"
          }
        }
      }
    },
    "onboarding.location.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on your device. We send only a coordinate to fetch the cloud forecast, never your identity and never a history of where you've been."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonen din forblir på enheten din. Vi sender bare en koordinat for å hente skyvarselet, aldri identiteten din og aldri en historikk over hvor du har vært."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plats stannar på din enhet. Vi skickar bara en koordinat för att hämta molnprognosen, aldrig din identitet och aldrig en historik över var du har varit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintisi pysyy laitteellasi. Lähetämme vain koordinaatin pilviennusteen hakemista varten, emme koskaan henkilöllisyyttäsi tai historiaa siitä, missä olet käynyt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din placering forbliver på din enhed. Vi sender kun en koordinat for at hente skyudsigten, aldrig din identitet og aldrig en historik over, hvor du har været."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort bleibt auf deinem Gerät. Wir senden nur eine Koordinate, um die Wolkenvorhersage abzurufen, niemals deine Identität und niemals einen Verlauf deiner Aufenthaltsorte."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie blijft op je toestel. We sturen alleen een coördinaat om de bewolkingsvoorspelling op te halen, nooit je identiteit en nooit een geschiedenis van waar je bent geweest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position reste sur votre appareil. Nous n'envoyons qu'une coordonnée pour récupérer les prévisions de nuages, jamais votre identité ni un historique de vos déplacements."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja lokalizacja pozostaje na urządzeniu. Wysyłamy tylko współrzędne potrzebne do pobrania lokalnej prognozy zachmurzenia — nigdy Twojej tożsamości ani historii miejsc, w których byłeś(-aś)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione resta sul dispositivo. Inviamo solo una coordinata per ottenere la previsione locale delle nuvole, mai la tua identità né una cronologia dei luoghi in cui sei stato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación permanece en tu dispositivo. Solo enviamos unas coordenadas para obtener el pronóstico local de nubes; nunca tu identidad ni un historial de los lugares en los que has estado."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poloha zůstává ve vašem zařízení. Odesíláme jen souřadnici pro získání místní předpovědi oblačnosti, nikdy vaši totožnost ani historii míst, kde jste byli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報はデバイス内に保持されます。現地の雲予報を取得するために座標だけを送信し、個人情報や訪れた場所の履歴は送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보는 기기에 남습니다. 지역 구름 예보를 가져오기 위한 좌표만 전송하며, 신원이나 방문 장소 기록은 절대 전송하지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的位置會留在裝置上。我們只傳送座標以取得當地雲量預報，絕不傳送你的身分或曾去過哪些地方的紀錄。"
          }
        }
      }
    },
    "onboarding.location.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sky are we watching?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken himmel følger vi med på?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken himmel bevakar vi?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä taivasta seuraamme?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken himmel følger vi med på?"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Himmel beobachten wir?"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke hemel houden we in de gaten?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel ciel observons-nous ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Które niebo obserwujemy?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale cielo stiamo osservando?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cielo estamos observando?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kterou oblohu sledujeme?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの空を見守りますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 하늘을 지켜볼까요?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們要觀察哪片天空？"
          }
        }
      }
    },
    "onboarding.nightVision.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap outside, and the whole app goes red. You keep your night vision, and you can still read the screen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk ute, og hele appen blir rød. Du beholder nattsynet, og du kan fortsatt lese skjermen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck utomhus, och hela appen blir röd. Du behåller ditt mörkerseende, och du kan fortfarande läsa skärmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus ulkona, ja koko sovellus muuttuu punaiseksi. Säilytät hämäränäkösi ja voit silti lukea näyttöä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tryk udenfor, og hele appen bliver rød. Du bevarer dit natsyn, og du kan stadig læse skærmen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp draußen, und die ganze App wird rot. Du behältst deine Nachtsicht und kannst den Bildschirm trotzdem lesen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik buiten, en de hele app wordt rood. Je nachtzicht blijft intact en je kunt het scherm nog steeds lezen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pression dehors, et toute l'appli passe au rouge. Vous gardez votre vision nocturne, sans perdre l'écran de vue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stuknięcie na zewnątrz i cała aplikacja przechodzi na czerwony ekran. Zachowujesz widzenie nocne, a ekran nadal pozostaje czytelny."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco all’aperto e tutta l’app diventa rossa. Conservi la visione notturna e riesci comunque a leggere lo schermo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque cuando estás fuera y toda la app se vuelve roja. Conservas la visión nocturna y puedes seguir leyendo la pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno klepnutí venku a celá aplikace se přepne do červené. Zachováte si noční vidění a stále přečtete obrazovku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外で1回タップすると、アプリ全体が赤色表示になります。暗順応を保ちながら画面を読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밖에서 한 번 탭하면 앱 전체가 붉게 바뀝니다. 암순응을 유지하면서 화면도 읽을 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在戶外輕點一下，整個 App 就會切成紅色。既能保留夜視能力，也能繼續看清螢幕。"
          }
        }
      }
    },
    "onboarding.nightVision.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light keeps your eyes adjusted."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rødt lys holder øynene tilpasset mørket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rött ljus håller ögonen anpassade till mörkret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punainen valo pitää silmäsi sopeutuneina."
          }
        },
        "da": {
