    "onboarding.quiz.wound.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you ever missed one?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du noen gang gått glipp av et?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du någonsin missat ett?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletko koskaan jäänyt paitsi yhdestä?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du nogensinde gået glip af et?"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du schon mal eins verpasst?"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je er ooit een gemist?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous déjà raté une aurore ?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy zdarzyło Ci się przegapić zorzę?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti è mai capitato di perdere un’aurora?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Alguna vez te has perdido una aurora?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už jste někdy polární záři propásli?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーロラを見逃したことはありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오로라를 놓친 적이 있나요?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你曾經錯過極光嗎？"
          }
        }
      }
    },
