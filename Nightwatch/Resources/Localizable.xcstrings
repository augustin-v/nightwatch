    "paywall.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop guessing. Start seeing."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutt å gjette. Begynn å se."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluta gissa. Börja se."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopeta arvailu. Ala näkemään."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop med at gætte. Begynd at se."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Schluss mit Raten. Fang an zu sehen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop met gokken. Begin met zien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez de deviner. Commencez à observer."
          }
        }
      }
    },
    "paywall.renewalTerms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically until cancelled. Cancel any time in your Apple account settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk til det avbestilles. Avbestill når som helst i innstillingene for Apple-kontoen din."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt tills det avbryts. Avbryt när som helst i inställningarna för ditt Apple-konto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti, kunnes se peruutetaan. Peru milloin tahansa Apple-tilisi asetuksista."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk, indtil det annulleres. Annuller når som helst i indstillingerne for din Apple-konto."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch bis zur Kündigung. Kündige jederzeit in den Einstellungen deines Apple-Accounts."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd totdat je opzegt. Zeg op ieder gewenst moment op via de instellingen van je Apple-account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle automatiquement jusqu'à annulation. Vous pouvez annuler à tout moment dans les réglages de votre compte Apple."
          }
        }
      }
    },
