    "places.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Every screen forecasts for the place selected here."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
