    },
    "paywall.renewalTerms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically until cancelled. Cancel any time in your Apple account settings."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk til det avbestilles. Avbestill når som helst i innstillingene for Apple-kontoen din."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas automatiskt tills det avbryts. Avbryt när som helst i inställningarna för ditt Apple-konto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu automaattisesti, kunnes se peruutetaan. Peru milloin tahansa Apple-tilisi asetuksista."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornyes automatisk, indtil det annulleres. Annuller når som helst i indstillingerne for din Apple-konto."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch bis zur Kündigung. Kündige jederzeit in den Einstellungen deines Apple-Accounts."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch verlengd totdat je opzegt. Zeg op ieder gewenst moment op via de instellingen van je Apple-account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle automatiquement jusqu'à annulation. Vous pouvez annuler à tout moment dans les réglages de votre compte Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja odnawia się automatycznie do czasu anulowania. Możesz anulować ją w dowolnym momencie w ustawieniach konta Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente fino all’annullamento. Puoi annullare in qualsiasi momento nelle impostazioni del tuo account Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente hasta que lo canceles. Puedes cancelar en cualquier momento desde los ajustes de tu cuenta de Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky se obnovuje až do zrušení. Předplatné můžete kdykoli zrušit v nastavení svého účtu Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルするまで自動更新されます。Apple Accountの設定からいつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소할 때까지 자동으로 갱신됩니다. Apple Account 설정에서 언제든 취소할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，直到你取消為止。你可以隨時在 Apple Account 設定中取消。"
          }
        }
      }
    },
