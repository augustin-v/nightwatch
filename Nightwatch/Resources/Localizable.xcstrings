    "places.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Save the spot you actually watch from, so you can check it without driving there first."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre stedet du faktisk følger med fra, så du kan sjekke det uten å kjøre dit først."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara platsen du faktiskt tittar från, så att du kan kolla den utan att köra dit först."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna paikka, jota oikeasti tarkkailet, jotta voit tarkistaa sen ajamatta sinne ensin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem stedet du faktisk kigger fra, så du kan tjekke det uden at køre derhen først."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere den Ort, von dem aus du wirklich beobachtest, damit du ihn prüfen kannst, ohne vorher hinzufahren."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de plek waar je écht vanaf kijkt, zodat je die kunt checken zonder er eerst naartoe te rijden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le site depuis lequel vous observez vraiment, pour pouvoir le consulter sans devoir d'abord vous y rendre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz miejsce, z którego naprawdę obserwujesz zorzę, aby sprawdzić prognozę bez wcześniejszej jazdy na miejsce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il punto da cui osservi davvero l’aurora, così puoi controllarlo senza doverci andare prima."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el lugar desde el que realmente observas auroras para poder comprobarlo sin tener que conducir hasta allí primero."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte místo, odkud polární záři skutečně sledujete, abyste ho mohli zkontrolovat bez předchozí cesty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に観測する場所を保存しておけば、そこまで行く前に予報を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 오로라를 보는 장소를 저장해 두면, 먼저 운전해 가지 않고도 그곳의 예보를 확인할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存你實際觀測極光的地點，就能在開車前先查看那裡的預報。"
          }
        }
      }
    },
    "places.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nowhere saved yet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen steder lagret ennå"
          }
        },
        "sv": {
