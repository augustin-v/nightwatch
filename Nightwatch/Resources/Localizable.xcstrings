          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Polarlichtoval auf einer Karte und wie weit du von seinem Rand entfernt bist."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De noorderlicht-ovaal op een kaart, en hoe ver je van de rand ervan bent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ovale auroral sur une carte, et votre distance par rapport à son bord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Owal zorzowy na mapie i Twoja odległość od jego krawędzi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ovale aurorale sulla mappa e la tua distanza dal suo bordo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El óvalo auroral en un mapa y tu distancia hasta su borde."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurorální ovál na mapě a vaše vzdálenost od jeho okraje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図上のオーロラオーバルと、その端までの距離を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도에서 오로라 오벌과 가장자리까지의 거리를 확인할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在地圖上查看極光橢圓，以及你距離其邊緣多遠。"
          }
        }
      }
    },
    "paywall.value.tonight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight's chance where you actually are, not a global Kp number."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjansen i kveld der du faktisk er, ikke et globalt Kp-tall."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chansen i kväll där du faktiskt är, inte ett globalt Kp-tal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän illan mahdollisuus siellä, missä oikeasti olet, ei globaali Kp-luku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chancen i aften der, hvor du faktisk er, ikke et globalt Kp-tal."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Chance heute Nacht genau dort, wo du bist, nicht eine globale Kp-Zahl."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De kans vanavond op de plek waar je echt bent, niet een globaal Kp-getal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilité de ce soir là où vous êtes réellement, pas un indice Kp global."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szansa na zorzę dziś w nocy dokładnie tam, gdzie jesteś — nie tylko globalny indeks Kp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilità di vedere l’aurora stanotte esattamente dove sei, non un indice Kp globale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La probabilidad de ver auroras esta noche exactamente donde estás, no un índice Kp global."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šance na polární záři dnes v noci přesně tam, kde jste — ne jen globální hodnota Kp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界全体のKp値ではなく、今いる場所で今夜オーロラが見える可能性を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계 Kp 수치가 아니라, 지금 있는 곳에서 오늘 밤 오로라를 볼 가능성을 확인하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是只看全球 Kp 數值，而是看你所在位置今晚看到極光的機會。"
          }
        }
      }
    },
