    "onboarding.reflection.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people miss most of them. Not because the aurora didn't show up, but because nobody told them it was clear at the right hour."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste går glipp av de fleste. Ikke fordi nordlyset ikke kom, men fordi ingen fortalte dem at himmelen var klar til rett tid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta missar de flesta. Inte för att norrskenet uteblev, utan för att ingen sa till dem att himlen var klar vid rätt tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useimmat jäävät paitsi useimmista. Ei siksi, ettei revontulia näkynyt, vaan koska kukaan ei kertonut heille, että taivas oli kirkas juuri oikealla hetkellä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste går glip af de fleste. Ikke fordi nordlyset ikke kom, men fordi ingen fortalte dem, at himlen var klar på det rette tidspunkt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Menschen verpassen die meisten davon. Nicht weil kein Polarlicht da war, sondern weil ihnen niemand gesagt hat, dass der Himmel zur richtigen Stunde klar war."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste mensen missen de meeste ervan. Niet omdat het noorderlicht wegbleef, maar omdat niemand hun vertelde dat het op het juiste moment helder was."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens en ratent la plupart. Pas parce que l'aurore n'était pas là, mais parce que personne ne leur a dit que le ciel était dégagé au bon moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większość osób przegapia większość okazji. Nie dlatego, że zorza się nie pojawia, lecz dlatego, że nikt nie powiedział im, że niebo będzie bezchmurne o właściwej porze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte delle persone perde la maggior parte delle occasioni. Non perché l’aurora non compaia, ma perché nessuno dice loro che il cielo sarà sereno all’ora giusta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de las personas se pierde la mayoría de las ocasiones. No porque no aparezca la aurora, sino porque nadie les dijo que el cielo estaría despejado a la hora adecuada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Většina lidí propásne většinu příležitostí. Ne proto, že by polární záře nepřišla, ale protože jim nikdo neřekl, že obloha bude ve správnou hodinu jasná."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの人は、ほとんどのチャンスを逃します。オーロラが出なかったからではなく、ちょうど良い時間に晴れると誰も教えてくれなかったからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 사람은 많은 기회를 놓칩니다. 오로라가 나타나지 않아서가 아니라, 딱 맞는 시간에 하늘이 맑다는 걸 알려주는 사람이 없기 때문입니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數人會錯過大多數機會。不是因為極光沒有出現，而是沒有人告訴他們，正確的時間天空其實是晴的。"
          }
        }
      }
    },
    "onboarding.reflection.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your latitude, you get roughly %@ realistic nights a year."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddegrad får du omtrent %@ realistiske netter i året."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddgrad får du ungefär %@ realistiska nätter per år."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveysasteellasi saat karkeasti %@ realistista yötä vuodessa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddegrad får du omkring %@ realistiske nætter om året."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Breitengrad hast du etwa %@ realistische Nächte pro Jahr."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op jouw breedtegraad zijn er ongeveer %@ kansrijke nachten per jaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À votre latitude, vous avez environ %@ nuits réalistes par an."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Twojej szerokości geograficznej masz około %@ realnych okazji w roku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla tua latitudine ci sono circa %@ notti realisticamente favorevoli all’anno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu latitud tienes aproximadamente %@ noches realmente favorables al año."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve vaší zeměpisné šířce máte přibližně %@ skutečně nadějných nocí za rok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この緯度では、現実的に狙える夜が年間およそ%@あります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 위도에서는 실제로 노려볼 만한 밤이 1년에 약 %@번 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的緯度，一年大約有 %@ 個真正值得把握的夜晚。"
          }
        }
      }
    },
    "onboarding.solution.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One answer. The window. And what's holding it back."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svar. Vinduet. Og hva som holder det tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svar. Fönstret. Och vad som håller det tillbaka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi vastaus. Ikkuna. Ja mikä sitä rajoittaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét svar. Vinduet. Og hvad der holder det tilbage."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Antwort. Das Zeitfenster. Und was es gerade verhindert."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén antwoord. Het tijdvenster. En wat het tegenhoudt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse. La fenêtre. Et ce qui la limite."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna odpowiedź. Najlepsza pora. I to, co ogranicza widoczność."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta. La finestra migliore. E cosa la sta limitando."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respuesta. La mejor ventana. Y lo que está limitando las condiciones."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna odpověď. Nejlepší okno. A to, co podmínky omezuje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えはひとつ。ベストな時間帯と、条件を妨げている要因まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 답. 가장 좋은 시간대. 그리고 무엇이 조건을 막고 있는지까지."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個答案。最佳時段。以及目前限制觀測條件的原因。"
          }
        }
      }
    },
    "onboarding.solution.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know by dinner whether tonight is worth it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet før middag om kvelden er verdt det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet redan till middagen om kvällen är värd det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedät jo päivällisaikaan, kannattaako tämä ilta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid allerede til aftensmad, om aftenen er det værd."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon beim Abendessen wissen, ob sich die Nacht lohnt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet al voor het avondeten of vanavond de moeite waard is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sachez dès le dîner si la nuit en vaut la peine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już przy kolacji wiesz, czy tej nocy warto wyjść."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapere già a cena se stanotte ne vale la pena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabrás a la hora de cenar si esta noche vale la pena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už u večeře víte, zda dnešní noc stojí za to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕食までに、今夜見る価値があるかわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저녁 식사 전에 오늘 밤 나갈 가치가 있는지 알 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚餐前就知道今晚值不值得出門。"
          }
        }
      }
    },
