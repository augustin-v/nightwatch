      }
    },
    "tonight.limitingFactor.darkness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not dark enough yet tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke mørkt nok ennå i kveld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är inte tillräckligt mörkt än i kväll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ole vielä tarpeeksi pimeää tänä yönä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke mørkt nok endnu i aften."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist heute Nacht noch nicht dunkel genug."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is vanavond nog niet donker genoeg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne fait pas encore assez nuit ce soir."
          }
        }
      }
    },
    "tonight.limitingFactor.moon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonlight is washing out the sky tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneskinn visker ut himmelen i kveld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månsken bleker ut himlen i kväll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuunvalo haalistaa taivasta tänä yönä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneskin visker himlen ud i aften."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondlicht überstrahlt heute Nacht den Himmel."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Maanlicht overstemt de hemel vanavond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clair de lune noie le ciel ce soir."
          }
        }
      }
    },
    "tonight.limitingFactor.none": {
