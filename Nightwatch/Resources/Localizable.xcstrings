          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet et tidligere abonnement for denne Apple-konto."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Apple-Account wurde kein früheres Abo gefunden."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen eerder abonnement gevonden voor dit Apple-account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun abonnement précédent n'a été trouvé pour ce compte Apple."
          }
