          "stringUnit": {
            "state": "translated",
            "value": "Przegapiłem(-am) zorzę, którą mogłem(-am) zobaczyć"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ho persa una che avrei potuto vedere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me perdí una que podría haber visto"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propásl(a) jsem jednu, kterou jsem mohl(a) vidět"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見られたはずのオーロラを逃したことがある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼 수 있었던 오로라를 놓친 적이 있어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曾錯過本來看得到的極光"
          }
        }
      }
    },
