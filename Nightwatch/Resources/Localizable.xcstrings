    "retention.offer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alerts when the sky finally clears. No three-night view. No saved places. The next good night will happen whether or not you're outside for it."
          }
        }
      }
    },
    "retention.offer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll go back to guessing."
