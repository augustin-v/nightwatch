{
  "sourceLanguage": "en",
  "strings": {
    "alert.notification.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions look worth checking around %@. Clear enough sky, dark enough sky, and real activity."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forholdene ser verdt å sjekke rundt %@. Himmel klar nok, himmel mørk nok, og reell aktivitet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhållandena ser värda att kolla upp kring %@. Himlen klar nog, himlen mörk nog, och verklig aktivitet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olosuhteet kannattaa tarkistaa noin klo %@. Taivas on tarpeeksi kirkas, tarpeeksi pimeä, ja revontuliaktiivisuutta on oikeasti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forholdene ser ud til at være værd at tjekke omkring %@. Himmel klar nok, himmel mørk nok, og reel aktivitet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blick gegen %@ könnte sich lohnen: klarer Himmel, dunkler Himmel und echte Aktivität."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond %@ is het de moeite waard om te kijken. Voldoende heldere hemel, voldoende donker, en echte activiteit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça vaut le coup d'œil vers %@ : ciel assez dégagé, ciel assez sombre et activité réelle."
          }
        }
      }
    },
    "alert.notification.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good aurora window tonight"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt nordlysvindu i kveld"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra norrskensfönster i kväll"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvä revontuli-ikkuna tänä yönä"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt nordlysvindue i aften"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gutes Polarlicht-Fenster heute Nacht"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed noorderlicht-moment vanavond"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurore boréale : bonne fenêtre ce soir"
          }
        }
      }
    },
    "alerts.enabled.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Notifications are scheduled on your device. Nothing is sent to a server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler planlegges på enheten din. Ingenting sendes til en server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar schemaläggs på din enhet. Inget skickas till en server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset ajastetaan laitteellasi. Mitään ei lähetetä palvelimelle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer planlægges på din enhed. Intet sendes til en server."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen werden auf deinem Gerät geplant. Nichts wird an einen Server gesendet."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen worden op je toestel ingepland. Er wordt niets naar een server gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont planifiées sur votre appareil. Rien n'est envoyé à un serveur."
          }
        }
      }
    },
    "alerts.enabled.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Alert me"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsle meg"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisera mig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytä minua"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Underret mig"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtige mich"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuw me"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'alerter"
          }
        }
      }
    },
    "alerts.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Alerts are worked out ahead of time from the three day forecast and refreshed whenever iOS next wakes the app in the background. A storm that arrives suddenly can beat the notification."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler beregnes på forhånd ut fra tredøgnsvarselet og oppdateres hver gang iOS neste gang vekker appen i bakgrunnen. En storm som kommer brått på, kan rekke å slå til før varselet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar beräknas i förväg utifrån tredygnsprognosen och uppdateras varje gång iOS nästa gång väcker appen i bakgrunden. En storm som kommer plötsligt kan hinna före aviseringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset lasketaan etukäteen kolmen päivän ennusteesta ja päivitetään aina, kun iOS seuraavan kerran herättää sovelluksen taustalla. Äkillisesti saapuva myrsky voi ehtiä ennen hälytystä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer beregnes på forhånd ud fra tredøgnsprognosen og opdateres, hver gang iOS næste gang vækker appen i baggrunden. En storm, der opstår pludseligt, kan nå at ramme, før notifikationen gør."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen werden im Voraus aus der Drei-Tage-Vorhersage berechnet und aktualisiert, sobald iOS die App das nächste Mal im Hintergrund weckt. Ein Sturm, der plötzlich eintrifft, kann der Benachrichtigung zuvorkommen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen worden vooraf berekend op basis van de driedaagse voorspelling en vernieuwd zodra iOS de app de volgende keer op de achtergrond wekt. Een storm die plotseling opsteekt, kan de melding voor zijn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont calculées à l'avance à partir des prévisions à trois jours et actualisées à chaque réveil de l'application en arrière-plan par iOS. Une tempête qui survient soudainement peut devancer l'alerte."
          }
        }
      }
    },
