    "places.add.noLocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Waiting for a location fix. Allow location access to save this spot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på posisjon. Gi tilgang til posisjon for å lagre dette stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på en platsposition. Tillåt platsåtkomst för att spara denna plats."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan sijaintitietoa. Salli sijaintikäyttö tallentaaksesi tämän paikan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på en placering. Giv adgang til placering for at gemme dette sted."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf eine Standortbestimmung. Erlaube den Standortzugriff, um diesen Ort zu speichern."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op een locatiebepaling. Geef locatietoegang om deze plek op te slaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'une position. Autorisez l'accès à la position pour enregistrer cet endroit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czekamy na ustalenie lokalizacji. Zezwól na dostęp do lokalizacji, aby zapisać to miejsce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa della posizione. Consenti l’accesso alla posizione per salvare questo punto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando una ubicación. Permite el acceso a la ubicación para guardar este lugar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká se na určení polohy. Povolte přístup k poloze, abyste toto místo mohli uložit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を取得しています。この場所を保存するには位置情報へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 확인하는 중입니다. 이 장소를 저장하려면 위치 접근을 허용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待定位。請允許位置存取權限以儲存這個地點。"
          }
        }
      }
    },
    "places.add.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This saves where you are standing right now. Give it a name you will recognise later."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette lagrer stedet du står på nå. Gi det et navn du kjenner igjen senere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta sparar platsen du står på just nu. Ge den ett namn du känner igen senare."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tallentaa paikan, jossa seisot juuri nyt. Anna sille nimi, jonka tunnistat myöhemmin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette gemmer stedet, du står på lige nu. Giv det et navn, du genkender senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das speichert den Ort, an dem du gerade stehst. Gib ihm einen Namen, den du später wiedererkennst."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit slaat de plek op waar je nu staat. Geef het een naam die je later herkent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci enregistre l'endroit où vous vous trouvez actuellement. Donnez-lui un nom que vous reconnaîtrez plus tard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz miejsce, w którym jesteś teraz. Nadaj mu nazwę, którą później rozpoznasz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il punto in cui ti trovi adesso. Dagli un nome che riconoscerai più tardi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto guarda el lugar en el que estás ahora. Ponle un nombre que reconozcas más adelante."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto uložíte místo, kde právě stojíte. Dejte mu název, který později poznáte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今いる場所を保存します。あとでわかる名前を付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 서 있는 곳을 저장합니다. 나중에 알아볼 수 있는 이름을 붙여주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會儲存你現在所在的位置。請取一個之後能認得的名稱。"
          }
        }
      }
    },
