    "onboarding.problem.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app said that. The sky was solid overcast. You lost two hours and a night's sleep."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var det appen din sa. Himmelen var helt overskyet. Du mistet to timer og en natts søvn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var vad din app sa. Himlen var helt mulen. Du förlorade två timmar och en natts sömn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi väitti niin. Taivas oli täysin pilvessä. Menetit kaksi tuntia ja yöunet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var det, din app sagde. Himlen var helt overskyet. Du mistede to timer og en nats søvn."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat deine App gesagt. Der Himmel war komplett bedeckt. Du hast zwei Stunden und eine Nacht Schlaf verloren."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zei je app. De hemel was potdicht bewolkt. Je verloor twee uur en een nachtrust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ce que votre appli disait. Le ciel était entièrement couvert. Vous avez perdu deux heures et une nuit de sommeil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak mówiła Twoja aplikacja. Niebo było całkowicie zachmurzone. Straciłeś(-aś) dwie godziny i część snu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo diceva la tua app. Il cielo era completamente coperto. Hai perso due ore e una notte di sonno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso decía tu app. El cielo estaba completamente cubierto. Perdiste dos horas y una noche de sueño."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To tvrdila vaše aplikace. Obloha byla úplně zatažená. Ztratili jste dvě hodiny a část nočního spánku."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはそう言っていたのに、空は一面の曇り。2時間と睡眠を無駄にしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 그렇게 말했지만 하늘은 완전히 흐렸습니다. 두 시간과 한밤의 잠을 잃었죠."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 App 是這麼說的，但天空完全被雲蓋住。你白跑了兩小時，還少睡一晚。"
          }
        }
      }
    },
