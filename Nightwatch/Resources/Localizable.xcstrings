          }
        }
      }
    },
    "onboarding.alerts.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora active, sky clear, sky dark, moon out of the way. All four, or your phone stays silent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlys aktivt, himmel klar, himmel mørk, måne ute av veien. Alle fire, ellers forblir telefonen stille."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norrsken aktivt, himlen klar, himlen mörk, månen ur vägen. Alla fyra, annars förblir telefonen tyst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Revontulet aktiiviset, taivas kirkas, taivas pimeä, kuu poissa tieltä. Kaikki neljä, tai puhelimesi pysyy hiljaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlys aktivt, himlen klar, himlen mørk, månen ude af vejen. Alle fire, ellers forbliver telefonen tavs."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Polarlicht aktiv, Himmel klar, Himmel dunkel, Mond aus dem Weg. Nur wenn alle vier stimmen, meldet sich dein Handy."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Noorderlicht actief, hemel helder, hemel donker, maan uit beeld. Alle vier, of je telefoon blijft stil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurore active, ciel dégagé, ciel sombre, lune absente. Les quatre à la fois, ou votre téléphone reste silencieux."
          }
        }
      }
    },
    "onboarding.alerts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only wake you when it's actually worth it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vekker deg bare når det faktisk er verdt det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi väcker dig bara när det faktiskt är värt det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herätämme sinut vain, kun se todella kannattaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vækker dig kun, når det faktisk er værd det."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir wecken dich nur, wenn es sich wirklich lohnt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We maken je alleen wakker als het echt de moeite waard is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne vous réveillons que quand ça en vaut vraiment la peine."
          }
        }
      }
    },
    "onboarding.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt"
          }
        },
        "fi": {
