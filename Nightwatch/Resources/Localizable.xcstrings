    "paywall.subheadline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch watches the sky so you don't have to."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch følger med på himmelen, så du slipper."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch bevakar himlen så att du slipper."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch tarkkailee taivasta, jotta sinun ei tarvitse."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch holder øje med himlen, så du ikke behøver."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch beobachtet den Himmel, damit du es nicht musst."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch houdt de hemel in de gaten, zodat jij dat niet hoeft te doen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch surveille le ciel pour que vous n'ayez pas à le faire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch obserwuje niebo za Ciebie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch osserva il cielo al posto tuo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch observa el cielo para que tú no tengas que hacerlo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch sleduje oblohu za vás."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatchがあなたの代わりに空を見守ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightwatch가 대신 하늘을 지켜봅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Nightwatch 替你盯著天空。"
          }
        }
      }
    },
    "paywall.value.alerts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alert only when a night crosses the strength you asked for."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et varsel bare når en natt når styrken du har bedt om."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En avisering bara när en natt når styrkan du bad om."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytys vain silloin, kun yö saavuttaa pyytämäsi voimakkuuden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En notifikation kun når en nat når den styrke, du har bedt om."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Benachrichtigung nur, wenn eine Nacht die von dir gewählte Stärke erreicht."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding alleen wanneer een nacht de door jou gekozen sterkte bereikt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte seulement lorsqu'une nuit atteint l'intensité que vous avez demandée."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alert tylko wtedy, gdy warunki osiągną wybrany przez Ciebie poziom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avviso solo quando la notte raggiunge l’intensità che hai scelto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una alerta solo cuando la noche alcanza la intensidad que elegiste."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění jen tehdy, když noc dosáhne vámi zvolené síly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ強さに達した夜だけ通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 강도 이상이 되는 밤에만 알림을 보냅니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有當今晚達到你指定的強度時才提醒。"
          }
        }
      }
    },
    "paywall.value.oval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The auroral oval on a map, and how far you are from its edge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlysovalen på et kart, og hvor langt du er fra kanten av den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norrskensovalen på en karta, och hur långt du är från dess kant."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Revontuliovaali kartalla ja kuinka kaukana olet sen reunasta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
