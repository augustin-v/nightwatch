    "tonight.empty.needsLocation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on location in Settings, or add a place you watch from."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på posisjon i Innstillinger, eller legg til et sted du ser fra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera plats i Inställningar, eller lägg till en plats du tittar från."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota sijainti käyttöön asetuksista, tai lisää paikka, josta tarkkailet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå placering til i Indstillinger, eller tilføj et sted, du ser fra."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Standort in den Einstellungen oder füge einen Beobachtungsort hinzu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatie aan in Instellingen, of voeg een plek toe van waaruit je kijkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la position dans les réglages, ou ajoutez un lieu d'observation."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz lokalizację w Ustawieniach lub dodaj miejsce, z którego obserwujesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva la posizione in Impostazioni oppure aggiungi un luogo da cui osservi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación en Ajustes o añade un lugar desde el que observes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte polohu v Nastavení nebo přidejte místo, odkud pozorujete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で位置情報をオンにするか、観測場所を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 위치를 켜거나 관측 장소를 추가하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中開啟位置，或新增你的觀測地點。"
          }
        }
      }
    },
    "tonight.empty.needsLocation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't know which sky to watch"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vet ikke hvilken himmel vi skal følge med på"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vet inte vilken himmel vi ska bevaka"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme tiedä, mitä taivasta seurata"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ved ikke, hvilken himmel vi skal følge med på"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir wissen nicht, welchen Himmel wir beobachten sollen"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We weten niet welke hemel we moeten volgen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne savons pas quel ciel observer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wiemy, które niebo obserwować"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sappiamo quale cielo osservare"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No sabemos qué cielo observar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevíme, kterou oblohu sledovat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの空を見ればよいかわかりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 하늘을 봐야 할지 알 수 없습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們不知道該觀察哪片天空"
          }
        }
      }
    },
    "tonight.empty.unavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't reach the space weather and cloud forecasts. Pull down to try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fikk ikke kontakt med romværet og skyvarselet. Dra ned for å prøve igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte nå rymdvädret och molnprognosen. Dra ner för att försöka igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme saaneet yhteyttä avaruussää- ja pilviennusteisiin. Vedä alaspäin yrittääksesi uudelleen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke få kontakt til rumvejret og skyudsigten. Træk ned for at prøve igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Weltraumwetter- und Wolkenvorhersage nicht abrufen. Zum erneuten Versuch nach unten ziehen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de ruimteweer- en bewolkingsvoorspellingen niet bereiken. Trek naar beneden om het opnieuw te proberen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer la météo spatiale et les prévisions de nuages. Tirez vers le bas pour réessayer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać danych pogody kosmicznej i zachmurzenia. Pociągnij w dół, aby spróbować ponownie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a raggiungere le previsioni di meteo spaziale e nuvolosità. Trascina verso il basso per riprovare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos obtener los pronósticos de meteorología espacial y nubosidad. Desliza hacia abajo para intentarlo de nuevo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se získat předpověď kosmického počasí a oblačnosti. Stažením dolů to zkuste znovu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宇宙天気と雲の予報を取得できませんでした。下に引いてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우주기상 및 구름 예보를 가져오지 못했습니다. 아래로 당겨 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得太空天氣和雲量預報。向下拉即可重試。"
          }
        }
      }
    },
