{
  "sourceLanguage": "en",
  "strings": {
    "alert.notification.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions look worth checking around %@ — clear enough sky, dark enough sky, and real activity."
          }
        }
      }
    },
    "alert.notification.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good aurora window tonight"
          }
        }
      }
    },
    "common.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "common.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        }
      }
    },
    "onboarding.alerts.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora active, sky clear, sky dark, moon out of the way. All four, or your phone stays silent."
          }
        }
      }
    },
    "onboarding.alerts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only wake you when it's actually worth it."
          }
        }
      }
    },
    "onboarding.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "onboarding.hook.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody told you it would be."
          }
        }
      }
    },
    "onboarding.hook.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You drove out. It was cloudy."
          }
        }
      }
    },
    "onboarding.location.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on your device. We send only a coordinate to fetch the cloud forecast — never your identity, never a history of where you've been."
          }
        }
      }
    },
    "onboarding.location.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sky are we watching?"
          }
        }
      }
    },
    "onboarding.nightVision.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap outside, and the whole app goes red. You keep your night vision, and you can still read the screen."
          }
        }
      }
    },
    "onboarding.nightVision.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light keeps your eyes adjusted."
          }
        }
      }
    },
    "onboarding.problem.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app said that. The sky was solid overcast. You lost two hours and a night's sleep."
          }
        }
      }
    },
    "onboarding.problem.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 tonight!”"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.halfHour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half an hour for a good night"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.hourOrMore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An hour or more, if it's genuinely worth it"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.notFar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not far — only if it's overhead"
          }
        }
      }
    },
    "onboarding.quiz.intent.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far would you drive for a real one?"
          }
        }
      }
    },
    "onboarding.quiz.latitude.option.farNorth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Far north — Norway, Iceland, Alaska, northern Canada"
          }
        }
      }
    },
