      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I chase most clear nights"
          }
        }
      }
    },
    "onboarding.quiz.wound.option.missedOne": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed one I could have seen"
          }
        }
      }
    },
