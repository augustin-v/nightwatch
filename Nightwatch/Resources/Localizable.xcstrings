    "onboarding.alerts.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora active, sky clear, sky dark, moon out of the way. All four, or your phone stays silent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlys aktivt, himmel klar, himmel mørk, måne ute av veien. Alle fire, ellers forblir telefonen stille."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norrsken aktivt, himlen klar, himlen mörk, månen ur vägen. Alla fyra, annars förblir telefonen tyst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Revontulet aktiiviset, taivas kirkas, taivas pimeä, kuu poissa tieltä. Kaikki neljä, tai puhelimesi pysyy hiljaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlys aktivt, himlen klar, himlen mørk, månen ude af vejen. Alle fire, ellers forbliver telefonen tavs."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Polarlicht aktiv, Himmel klar, Himmel dunkel, Mond aus dem Weg. Nur wenn alle vier stimmen, meldet sich dein Handy."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Noorderlicht actief, hemel helder, hemel donker, maan uit beeld. Alle vier, of je telefoon blijft stil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurore active, ciel dégagé, ciel sombre, lune absente. Les quatre à la fois, ou votre téléphone reste silencieux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywna zorza, bezchmurne i ciemne niebo, księżyc nie przeszkadza. Muszą zgadzać się wszystkie cztery warunki — inaczej telefon milczy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora attiva, cielo sereno, cielo buio, Luna fuori gioco. Servono tutte e quattro le condizioni, altrimenti il telefono resta in silenzio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora activa, cielo despejado, cielo oscuro y Luna sin molestar. Deben cumplirse las cuatro condiciones; si no, tu teléfono permanece en silencio."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní polární záře, jasno, tma a Měsíc nepřekáží. Musí platit všechny čtyři podmínky, jinak telefon zůstane tichý."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーロラが活発、晴天、十分な暗さ、月明かりの影響なし。4つすべてがそろったときだけ通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오로라 활발, 맑은 하늘, 충분한 어둠, 달빛 방해 없음. 네 조건이 모두 맞을 때만 휴대폰이 알려드립니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "極光活躍、天空晴朗、天色夠暗、月光不干擾。四個條件都符合，手機才會通知你。"
          }
        }
      }
    },
    "onboarding.alerts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only wake you when it's actually worth it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vekker deg bare når det faktisk er verdt det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi väcker dig bara när det faktiskt är värt det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Herätämme sinut vain, kun se todella kannattaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vækker dig kun, når det faktisk er værd det."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir wecken dich nur, wenn es sich wirklich lohnt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We maken je alleen wakker als het echt de moeite waard is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne vous réveillons que quand ça en vaut vraiment la peine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budzimy Cię tylko wtedy, gdy naprawdę warto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti svegliamo solo quando ne vale davvero la pena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo te despertamos cuando realmente vale la pena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzbudíme vás jen tehdy, když to opravdu stojí za to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に見る価値があるときだけ起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 볼 가치가 있을 때만 깨워드려요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有真的值得起床看時，我們才會叫醒你。"
          }
        }
      }
    },
