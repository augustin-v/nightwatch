    "cancel.detailPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you type here stays on this device."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du skriver her, blir værende på denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du skriver här stannar på den här enheten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tähän kirjoittamasi jää tälle laitteelle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, hvad du skriver her, forbliver på denne enhed."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du hier eingibst, bleibt auf diesem Gerät."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je hier typt, blijft op dit apparaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous saisissez ici reste sur cet appareil."
          }
        }
      }
    },
