    "tonight.limitingFactor.activity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurora activity is the limiting factor tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlysaktivitet er den begrensende faktoren i kveld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norrskensaktivitet är den begränsande faktorn i kväll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Revontuliaktiivisuus on tämän yön rajoittava tekijä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nordlysaktivitet er den begrænsende faktor i aften."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Polarlicht-Aktivität ist heute Nacht der limitierende Faktor."
