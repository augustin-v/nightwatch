    "tonight.hourlyStrip.flat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "No hour tonight rises above zero."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av nattens timer stiger over null."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen av nattens timmar stiger över noll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksikään tämän yön tunneista ei nouse nollan yläpuolelle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen af nattens timer stiger over nul."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Nacht steigt keine Stunde über null."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Vannacht komt geen enkel uur boven nul uit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune heure cette nuit ne dépasse zéro."
          }
        }
      }
    },
