    "onboarding.reflection.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people miss most of them — not because the aurora didn't show up, but because nobody told them it was clear at the right hour."
          }
        }
      }
    },
    "onboarding.reflection.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your latitude, you get roughly %@ realistic nights a year."
          }
        }
      }
    },
    "onboarding.solution.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One answer. The window. And what's holding it back."
          }
        }
      }
    },
    "onboarding.solution.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know by dinner whether tonight is worth it."
          }
        }
      }
    },
