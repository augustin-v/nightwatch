    "onboarding.reflection.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most people miss most of them. Not because the aurora didn't show up, but because nobody told them it was clear at the right hour."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste går glipp av de fleste. Ikke fordi nordlyset ikke kom, men fordi ingen fortalte dem at himmelen var klar til rett tid."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta missar de flesta. Inte för att norrskenet uteblev, utan för att ingen sa till dem att himlen var klar vid rätt tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useimmat jäävät paitsi useimmista. Ei siksi, ettei revontulia näkynyt, vaan koska kukaan ei kertonut heille, että taivas oli kirkas juuri oikealla hetkellä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste går glip af de fleste. Ikke fordi nordlyset ikke kom, men fordi ingen fortalte dem, at himlen var klar på det rette tidspunkt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Menschen verpassen die meisten davon. Nicht weil kein Polarlicht da war, sondern weil ihnen niemand gesagt hat, dass der Himmel zur richtigen Stunde klar war."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste mensen missen de meeste ervan. Niet omdat het noorderlicht wegbleef, maar omdat niemand hun vertelde dat het op het juiste moment helder was."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des gens en ratent la plupart. Pas parce que l'aurore n'était pas là, mais parce que personne ne leur a dit que le ciel était dégagé au bon moment."
          }
        }
      }
    },
    "onboarding.reflection.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At your latitude, you get roughly %@ realistic nights a year."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddegrad får du omtrent %@ realistiske netter i året."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddgrad får du ungefär %@ realistiska nätter per år."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leveysasteellasi saat karkeasti %@ realistista yötä vuodessa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På din breddegrad får du omkring %@ realistiske nætter om året."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Breitengrad hast du etwa %@ realistische Nächte pro Jahr."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op jouw breedtegraad heb je ongeveer %@ realistische avonden per jaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À votre latitude, vous avez environ %@ nuits réalistes par an."
          }
        }
      }
    },
    "onboarding.solution.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One answer. The window. And what's holding it back."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svar. Vinduet. Og hva som holder det tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett svar. Fönstret. Och vad som håller det tillbaka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi vastaus. Ikkuna. Ja mikä sitä rajoittaa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét svar. Vinduet. Og hvad der holder det tilbage."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Antwort. Das Zeitfenster. Und was es gerade verhindert."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén antwoord. Het tijdvenster. En wat het tegenhoudt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse. La fenêtre. Et ce qui la limite."
          }
        }
      }
    },
    "onboarding.solution.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know by dinner whether tonight is worth it."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet før middag om kvelden er verdt det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vet redan till middagen om kvällen är värd det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedät jo päivällisaikaan, kannattaako tämä ilta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid allerede til aftensmad, om aftenen er det værd."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon zum Abendessen wissen, ob sich heute Nacht lohnt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet al voor het avondeten of vanavond de moeite waard is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sachez dès le dîner si la nuit en vaut la peine."
          }
        }
      }
    },
