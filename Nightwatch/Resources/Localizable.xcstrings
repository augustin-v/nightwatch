    "nights.empty.needsLocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Choose a place, or allow location access, to see the nights ahead."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et sted, eller gi tilgang til posisjon, for å se de kommende nettene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en plats, eller tillåt platsåtkomst, för att se de kommande nätterna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse paikka tai salli sijaintikäyttö nähdäksesi tulevat yöt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et sted, eller giv adgang til placering, for at se de kommende nætter."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ort, oder erlaube den Standortzugriff, um die kommenden Nächte zu sehen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een plek, of geef locatietoegang, om de komende nachten te zien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un lieu, ou autorisez l'accès à la position, pour voir les prochaines nuits."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miejsce lub zezwól na dostęp do lokalizacji, aby zobaczyć prognozę na kolejne noce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un luogo o consenti l’accesso alla posizione per vedere le prossime notti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un lugar o permite el acceso a la ubicación para ver las próximas noches."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte místo nebo povolte přístup k poloze, abyste viděli předpověď na další noci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を選ぶか位置情報へのアクセスを許可すると、今後の夜の予報を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 선택하거나 위치 접근을 허용하면 앞으로의 밤 예보를 볼 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇地點或允許取用位置，即可查看接下來幾晚的預報。"
          }
        }
      }
    },
    "nights.empty.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The forecast could not be loaded. Pull down to try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Værmeldingen kunne ikke lastes. Dra ned for å prøve igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen kunde inte läsas in. Dra nedåt för att försöka igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennustetta ei voitu ladata. Vedä alaspäin yrittääksesi uudelleen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen kunne ikke indlæses. Træk ned for at prøve igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorhersage konnte nicht geladen werden. Zum erneuten Versuch nach unten ziehen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorspelling kon niet worden geladen. Trek naar beneden om het opnieuw te proberen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les prévisions. Tirez vers le bas pour réessayer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać prognozy. Pociągnij w dół, aby spróbować ponownie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la previsione. Trascina verso il basso per riprovare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar el pronóstico. Desliza hacia abajo para intentarlo de nuevo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předpověď se nepodařilo načíst. Stažením dolů to zkuste znovu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予報を読み込めませんでした。下に引いてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예보를 불러오지 못했습니다. 아래로 당겨 다시 시도하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入預報。向下拉即可重試。"
          }
        }
      }
    },
