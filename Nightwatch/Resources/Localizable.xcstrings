    "map.headline.inside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You are about %@ inside the oval tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er omtrent %@ inne i ovalen i kveld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är ungefär %@ inne i ovalen i kväll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet noin %@ ovaalin sisäpuolella tänä yönä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er omkring %@ inde i ovalen i aften."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist heute Nacht etwa %@ innerhalb des Ovals."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bevindt je vanavond ongeveer %@ binnen de ovaal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à environ %@ à l'intérieur de l'ovale ce soir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś w nocy jesteś około %@ wewnątrz owalu zorzowego."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanotte sei circa %@ all’interno dell’ovale aurorale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noche estás aproximadamente %@ dentro del óvalo auroral."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes v noci jste přibližně %@ uvnitř aurorálního oválu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜はオーロラオーバルの内側に約%@入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 오로라 오벌 안쪽으로 약 %@ 들어와 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚你大約位於極光橢圓內 %@。"
          }
        }
      }
    },
