    "tonight.empty.needsLocation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on location in Settings, or add a place you watch from."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på posisjon i Innstillinger, eller legg til et sted du ser fra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera plats i Inställningar, eller lägg till en plats du tittar från."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota sijainti käyttöön asetuksista, tai lisää paikka, josta tarkkailet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå placering til i Indstillinger, eller tilføj et sted, du ser fra."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Standort in den Einstellungen oder füge einen Beobachtungsort hinzu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatie aan in Instellingen, of voeg een plek toe van waaruit je kijkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la position dans les réglages, ou ajoutez un lieu d'observation."
          }
        }
      }
    },
    "tonight.empty.needsLocation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't know which sky to watch"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vet ikke hvilken himmel vi skal følge med på"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vet inte vilken himmel vi ska bevaka"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme tiedä, mitä taivasta seurata"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ved ikke, hvilken himmel vi skal følge med på"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir wissen nicht, welchen Himmel wir beobachten sollen"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We weten niet welke hemel we moeten volgen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne savons pas quel ciel observer"
          }
        }
      }
    },
    "tonight.empty.unavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't reach the space weather and cloud forecasts. Pull down to try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fikk ikke kontakt med romværet og skyvarselet. Dra ned for å prøve igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte nå rymdvädret och molnprognosen. Dra ner för att försöka igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Emme saaneet yhteyttä avaruussää- ja pilviennusteisiin. Vedä alaspäin yrittääksesi uudelleen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke få kontakt til rumvejret og skyudsigten. Træk ned for at prøve igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Weltraumwetter- und Wolkenvorhersage nicht abrufen. Zum erneuten Versuch nach unten ziehen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de ruimteweer- en bewolkingsvoorspellingen niet bereiken. Trek naar beneden om het opnieuw te proberen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récupérer la météo spatiale et les prévisions de nuages. Tirez vers le bas pour réessayer."
          }
        }
      }
    },
