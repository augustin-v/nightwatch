          "stringUnit": {
            "state": "translated",
            "value": "L'activité de l'aurore boréale est le facteur limitant ce soir."
          }
        }
      }
    },
    "tonight.limitingFactor.clouds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clouds are the problem tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyer er problemet i kveld."
          }
        },
        "sv": {
