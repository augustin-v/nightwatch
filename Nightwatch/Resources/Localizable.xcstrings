    "paywall.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That purchase did not go through. Nothing was charged."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ble ikke gjennomført. Ingenting ble belastet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick inte igenom. Inget belopp har dragits."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu suorittaa. Sinulta ei veloitettu mitään."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet blev ikke gennemført. Der er ikke opkrævet noget."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Es wurde nichts berechnet."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop is niet gelukt. Er is niets in rekening gebracht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n'a pas abouti. Aucun montant n'a été débité."
          }
        }
      }
    },
    "paywall.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection to the App Store. Check your network and try again."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen forbindelse til App Store. Sjekk nettverket og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen anslutning till App Store. Kontrollera ditt nätverk och försök igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei yhteyttä App Storeen. Tarkista verkkoyhteytesi ja yritä uudelleen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen forbindelse til App Store. Tjek dit netværk, og prøv igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung zum App Store. Überprüfe dein Netzwerk und versuche es erneut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding met de App Store. Controleer je netwerk en probeer het opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion à l'App Store. Vérifiez votre connexion et réessayez."
          }
        }
      }
    },
    "paywall.error.notAllowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
