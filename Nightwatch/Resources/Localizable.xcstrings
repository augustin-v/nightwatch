{
  "sourceLanguage": "en",
  "strings": {
    "alert.notification.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions look worth checking around %@. Clear enough sky, dark enough sky, and real activity."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forholdene ser verdt å sjekke rundt %@. Himmel klar nok, himmel mørk nok, og reell aktivitet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhållandena ser värda att kolla upp kring %@. Himlen klar nog, himlen mörk nog, och verklig aktivitet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olosuhteet kannattaa tarkistaa noin klo %@. Taivas on tarpeeksi kirkas, tarpeeksi pimeä, ja revontuliaktiivisuutta on oikeasti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forholdene ser ud til at være værd at tjekke omkring %@. Himmel klar nok, himmel mørk nok, og reel aktivitet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blick gegen %@ könnte sich lohnen: klarer Himmel, dunkler Himmel und echte Aktivität."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond %@ is het de moeite waard om te kijken. Voldoende heldere hemel, voldoende donker, en echte activiteit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça vaut le coup d'œil vers %@ : ciel assez dégagé, ciel assez sombre et activité réelle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warto sprawdzić warunki około %@. Niebo jest dość bezchmurne i ciemne, a aktywność zorzy jest wyraźna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale la pena controllare le condizioni verso le %@. Cielo abbastanza sereno e buio, con vera attività aurorale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale la pena comprobar las condiciones hacia las %@. Cielo suficientemente despejado y oscuro, con actividad auroral real."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolem %@ stojí podmínky za kontrolu. Obloha je dostatečně jasná a tmavá a aktivita polární záře je skutečná."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ごろは確認する価値がありそうです。空は十分に晴れて暗く、オーロラ活動もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@쯤 확인해 볼 만한 조건입니다. 하늘이 충분히 맑고 어두우며 오로라 활동도 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 左右值得查看。天空夠晴、夠暗，而且確實有極光活動。"
          }
        }
      }
    },
    "alert.notification.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good aurora window tonight"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt nordlysvindu i kveld"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra norrskensfönster i kväll"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvä revontuli-ikkuna tänä yönä"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godt nordlysvindue i aften"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gutes Polarlicht-Fenster heute Nacht"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Goed noorderlicht-moment vanavond"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurore boréale : bonne fenêtre ce soir"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre warunki na zorzę dziś w nocy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buona finestra per l’aurora stanotte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena ventana para ver auroras esta noche"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobré podmínky pro polární záři dnes v noci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜はオーロラ観測の好条件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 오로라 관측에 좋은 시간"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚有不錯的極光觀測時段"
          }
        }
      }
    },
    "alerts.enabled.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Notifications are scheduled on your device. Nothing is sent to a server."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler planlegges på enheten din. Ingenting sendes til en server."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar schemaläggs på din enhet. Inget skickas till en server."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset ajastetaan laitteellasi. Mitään ei lähetetä palvelimelle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer planlægges på din enhed. Intet sendes til en server."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen werden auf deinem Gerät geplant. Nichts wird an einen Server gesendet."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen worden op je toestel ingepland. Er wordt niets naar een server gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont planifiées sur votre appareil. Rien n'est envoyé à un serveur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są planowane na Twoim urządzeniu. Nic nie jest wysyłane na serwer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche vengono programmate sul tuo dispositivo. Non viene inviato nulla a un server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones se programan en tu dispositivo. No se envía nada a un servidor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení se plánují přímo ve vašem zařízení. Nic se neposílá na server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はこのデバイス上でスケジュールされます。サーバーには何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 기기에서 예약됩니다. 서버로 전송되는 정보는 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知會直接在你的裝置上排程，不會傳送任何資料到伺服器。"
          }
        }
      }
    },
    "alerts.enabled.title": {
