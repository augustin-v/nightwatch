          "stringUnit": {
            "state": "translated",
            "value": "Deja de adivinar. Empieza a ver."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přestaňte hádat. Začněte pozorovat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勘に頼らず、オーロラを見よう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추측은 그만. 오로라를 만나세요."
