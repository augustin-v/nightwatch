    "paywall.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That purchase did not go through. Nothing was charged."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ble ikke gjennomført. Ingenting ble belastet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick inte igenom. Inget belopp har dragits."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu suorittaa. Sinulta ei veloitettu mitään."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet blev ikke gennemført. Der er ikke opkrævet noget."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Es wurde nichts berechnet."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoop is niet gelukt. Er is niets in rekening gebracht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet achat n'a pas abouti. Aucun montant n'a été débité."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup nie został zrealizowany. Nic nie pobrano z konta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto non è andato a buon fine. Non è stato addebitato nulla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se completó. No se ha cobrado nada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup se nezdařil. Nic vám nebylo účtováno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。料金は発生していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 완료되지 않았습니다. 결제된 금액은 없습니다."
