    "tonight.bestWindow.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No viable window tonight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke noe godt vindu i kveld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget bra fönster i kväll."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei toimivaa ikkunaa tänä yönä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet brugbart vindue i aften."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Nacht kein nutzbares Fenster."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen haalbaar tijdvenster vanavond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune fenêtre valable ce soir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dobrego okna dziś w nocy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna finestra utile stanotte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una ventana favorable esta noche."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes v noci není žádné vhodné okno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜は有望な時間帯がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤은 유효한 관측 시간대가 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今晚沒有適合觀測的時段。"
          }
        }
      }
    },
