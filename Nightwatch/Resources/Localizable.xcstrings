            "state": "translated",
            "value": "Jatka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorgaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "onboarding.hook.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody told you it would be."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fortalte deg at det ville skje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sa till dig att det skulle bli så."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kukaan ei kertonut sinulle etukäteen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen fortalte dig, at det ville ske."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat dir keiner gesagt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand had je gewaarschuwd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne vous avait prévenu."
          }
        }
      }
    },
    "onboarding.hook.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You drove out. It was cloudy."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kjørte ut. Det var overskyet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du körde ut. Det var mulet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoit sinne. Taivas oli pilvessä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kørte ud. Det var overskyet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist rausgefahren. Es war bewölkt."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je reed erheen. Het was bewolkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sorti. Le ciel était couvert."
          }
        }
      }
    },
    "onboarding.location.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location stays on your device. We send only a coordinate to fetch the cloud forecast, never your identity and never a history of where you've been."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Posisjonen din forblir på enheten din. Vi sender bare en koordinat for å hente skyvarselet, aldri identiteten din og aldri en historikk over hvor du har vært."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plats stannar på din enhet. Vi skickar bara en koordinat för att hämta molnprognosen, aldrig din identitet och aldrig en historik över var du har varit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sijaintisi pysyy laitteellasi. Lähetämme vain koordinaatin pilviennusteen hakemista varten, emme koskaan henkilöllisyyttäsi tai historiaa siitä, missä olet käynyt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din placering forbliver på din enhed. Vi sender kun en koordinat for at hente skyudsigten, aldrig din identitet og aldrig en historik over, hvor du har været."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort bleibt auf deinem Gerät. Wir senden nur eine Koordinate, um die Wolkenvorhersage abzurufen, niemals deine Identität und niemals einen Verlauf deiner Aufenthaltsorte."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie blijft op je toestel. We sturen alleen een coördinaat om de bewolkingsvoorspelling op te halen, nooit je identiteit en nooit een geschiedenis van waar je bent geweest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position reste sur votre appareil. Nous n'envoyons qu'une coordonnée pour récupérer les prévisions de nuages, jamais votre identité ni un historique de vos déplacements."
          }
        }
      }
    },
    "onboarding.location.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which sky are we watching?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken himmel følger vi med på?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken himmel bevakar vi?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä taivasta seuraamme?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken himmel følger vi med på?"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Welchen Himmel beobachten wir?"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke hemel houden we in de gaten?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel ciel observons-nous ?"
          }
        }
      }
    },
    "onboarding.nightVision.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap outside, and the whole app goes red. You keep your night vision, and you can still read the screen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett trykk ute, og hele appen blir rød. Du beholder nattsynet, og du kan fortsatt lese skjermen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tryck utomhus, och hela appen blir röd. Du behåller ditt mörkerseende, och du kan fortfarande läsa skärmen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi napautus ulkona, ja koko sovellus muuttuu punaiseksi. Säilytät hämäränäkösi ja voit silti lukea näyttöä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tryk udenfor, og hele appen bliver rød. Du bevarer dit natsyn, og du kan stadig læse skærmen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp draußen, und die ganze App wird rot. Du behältst deine Nachtsicht und kannst den Bildschirm trotzdem lesen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén tik buiten, en de hele app wordt rood. Je nachtzicht blijft intact en je kunt het scherm nog steeds lezen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pression dehors, et toute l'appli passe au rouge. Vous gardez votre vision nocturne, sans perdre l'écran de vue."
          }
        }
      }
    },
    "onboarding.nightVision.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red light keeps your eyes adjusted."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rødt lys holder øynene tilpasset mørket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rött ljus håller ögonen anpassade till mörkret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punainen valo pitää silmäsi sopeutuneina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rødt lys holder øjnene tilvænnet mørket."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotlicht erhält deine Augenanpassung."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rood licht houdt je ogen aangepast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière rouge préserve votre adaptation à l'obscurité."
          }
        }
      }
    },
    "onboarding.problem.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app said that. The sky was solid overcast. You lost two hours and a night's sleep."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var det appen din sa. Himmelen var helt overskyet. Du mistet to timer og en natts søvn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var vad din app sa. Himlen var helt mulen. Du förlorade två timmar och en natts sömn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi väitti niin. Taivas oli täysin pilvessä. Menetit kaksi tuntia ja yöunet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var det, din app sagde. Himlen var helt overskyet. Du mistede to timer og en nats søvn."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das hat deine App gesagt. Der Himmel war komplett bedeckt. Du hast zwei Stunden und eine Nacht Schlaf verloren."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zei je app. De hemel was potdicht bewolkt. Je verloor twee uur en een nachtrust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ce que votre appli disait. Le ciel était entièrement couvert. Vous avez perdu deux heures et une nuit de sommeil."
          }
        }
      }
    },
    "onboarding.problem.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 tonight!”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 i kveld!”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 i kväll!”"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Kp 6 tänä yönä!”"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 i aften!”"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kp 6 heute Nacht!“"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "“Kp 6 vanavond!”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Kp 6 ce soir ! »"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.halfHour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half an hour for a good night"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En halvtime for en god natt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En halvtimme för en bra natt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoli tuntia, jos yö on hyvä"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En halv time for en god nat"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine halbe Stunde für eine gute Nacht"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een half uur voor een goede avond"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demi-heure pour une bonne nuit"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.hourOrMore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An hour or more, if it's genuinely worth it"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En time eller mer, hvis det virkelig er verdt det"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En timme eller mer, om det verkligen är värt det"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunti tai enemmän, jos se todella kannattaa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En time eller mere, hvis det virkelig er det værd"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stunde oder mehr, wenn es sich wirklich lohnt"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een uur of meer, als het echt de moeite waard is"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une heure ou plus, si ça en vaut vraiment la peine"
          }
        }
      }
    },
    "onboarding.quiz.intent.option.notFar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not far, only if it's overhead"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke langt, bare hvis det er rett over meg"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte långt, bara om det syns rakt ovanför"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "En kauas, vain jos se näkyy suoraan yllä"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke langt, kun hvis det er lige over hovedet"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht weit, nur wenn es direkt über mir ist"
          }
        },
