          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorňovat mě"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 받기"
          }
        },
