            "state": "translated",
            "value": "提醒我"
          }
        }
      }
    },
    "alerts.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Alerts are worked out ahead of time from the three day forecast and refreshed whenever iOS next wakes the app in the background. A storm that arrives suddenly can beat the notification."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler beregnes på forhånd ut fra tredøgnsvarselet og oppdateres hver gang iOS neste gang vekker appen i bakgrunnen. En storm som kommer brått på, kan rekke å slå til før varselet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviseringar beräknas i förväg utifrån tredygnsprognosen och uppdateras varje gång iOS nästa gång väcker appen i bakgrunden. En storm som kommer plötsligt kan hinna före aviseringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset lasketaan etukäteen kolmen päivän ennusteesta ja päivitetään aina, kun iOS seuraavan kerran herättää sovelluksen taustalla. Äkillisesti saapuva myrsky voi ehtiä ennen hälytystä."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer beregnes på forhånd ud fra tredøgnsprognosen og opdateres, hver gang iOS næste gang vækker appen i baggrunden. En storm, der opstår pludseligt, kan nå at ramme, før notifikationen gør."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen werden im Voraus aus der Drei-Tage-Vorhersage berechnet und aktualisiert, sobald iOS die App das nächste Mal im Hintergrund weckt. Ein Sturm, der plötzlich eintrifft, kann der Benachrichtigung zuvorkommen."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen worden vooraf berekend op basis van de driedaagse voorspelling en vernieuwd zodra iOS de app de volgende keer op de achtergrond wekt. Een storm die plotseling opsteekt, kan de melding voor zijn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont calculées à l'avance à partir des prévisions à trois jours et actualisées à chaque réveil de l'application en arrière-plan par iOS. Une tempête qui survient soudainement peut devancer l'alerte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty są obliczane z wyprzedzeniem na podstawie prognozy na trzy dni i odświeżane, gdy iOS ponownie uruchomi aplikację w tle. Nagła burza geomagnetyczna może pojawić się przed powiadomieniem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi vengono calcolati in anticipo dalla previsione a tre giorni e aggiornati quando iOS riattiva l’app in background. Una tempesta geomagnetica improvvisa può arrivare prima della notifica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas se calculan con antelación a partir del pronóstico de tres días y se actualizan cuando iOS vuelve a activar la app en segundo plano. Una tormenta geomagnética repentina puede adelantarse a la notificación."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění se počítají předem z třídenní předpovědi a aktualizují se, kdykoli iOS znovu probudí aplikaci na pozadí. Náhlá geomagnetická bouře může dorazit dřív než oznámení."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は3日間の予報から事前に計算され、iOSが次にバックグラウンドでアプリを起動したときに更新されます。急に発生した磁気嵐は通知より先に到来する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 3일 예보를 바탕으로 미리 계산되며 iOS가 다음에 백그라운드에서 앱을 깨울 때 갱신됩니다. 갑자기 발생한 지자기 폭풍은 알림보다 먼저 도착할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒會根據三天預報預先計算，並在 iOS 下次於背景喚醒 App 時更新。若地磁暴突然抵達，可能會比通知更快發生。"
          }
        }
      }
    },
